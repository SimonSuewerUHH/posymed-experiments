// Minimal Nextflow config for the PoSyMed WF12 re-implementation.
manifest {
    name        = 'posymed-wf12-nextflow'
    description = 'Nextflow re-implementation of PoSyMed Workflow 12 (split / parallel GMM / merge)'
    mainScript  = 'main.nf'
}

workDir = 'work'

report   { enabled = true; overwrite = true; file = 'results/nextflow_report.html' }
timeline { enabled = true; overwrite = true; file = 'results/nextflow_timeline.html' }
dag      { enabled = true; overwrite = true; file = 'results/nextflow_dag.html' }
